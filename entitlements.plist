<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 다른 AirDrop 기기를 탐색/송신 -->
	<key>com.apple.private.airdrop.discovery</key>
	<true/>

	<!-- 애플TV가 AirDrop 서버로 보이게(수신 광고) -->
	<key>com.apple.private.airdrop.settings</key>
	<true/>

	<!--
	  v3 추가분.

	  v2 실행 결과, 위의 두 권한은 런타임에 분명히 적용돼 있었는데도
	  setDiscoverableMode: 가 반영되지 않았습니다. 즉 권한 자체는 있으나
	  sharingd 가 요청을 받아들이지 않는 상태로 보입니다.

	  Breezy 는 이 호출을 '앱'이 아니라 루트 권한의 상주 데몬에서 했습니다.
	  샌드박스 안의 일반 앱이라는 점이 거절 사유일 가능성이 있어,
	  TrollStore 가 허용하는 범위에서 그 조건에 가깝게 맞춰 봅니다.

	  platform-application 은 샌드박스의 일부를 오히려 조이는 부작용이
	  있어, 자기 데이터 컨테이너 접근용 권한을 함께 넣습니다.
	-->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
</dict>
</plist>
